# Optional AWS CLI profile. Change this to your test account profile.
AWS_PROFILE=default
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

# AWS region and existing EC2 SSH key used by the CAPI-managed AWS cluster.
AWS_REGION=us-east-1
AWS_SSH_KEY_NAME=capa-test

MANAGEMENT_CLUSTER_NAME=capa-test
MANAGEMENT_CLUSTER_KUBERNETES_VERSION=v1.35.0
MANAGEMENT_CLUSTER_CONTROL_PLANE_MACHINE_TYPE=t3.large
MANAGEMENT_CLUSTER_NODE_MACHINE_TYPE=t3.large
MANAGEMENT_CLUSTER_CONTROL_PLANE_MACHINE_COUNT=1
MANAGEMENT_CLUSTER_WORKER_MACHINE_COUNT=1

MANAGEMENT_CLUSTER_KUBECONFIG=_artifacts/capa-test.kubeconfig
BOOTSTRAP_CLUSTER_KUBECONFIG=_artifacts/capa-test-bootstrap.kubeconfig
MANAGEMENT_CLUSTER_READY_TIMEOUT=30m
MANAGEMENT_CLUSTER_DELETE_TIMEOUT=30m
